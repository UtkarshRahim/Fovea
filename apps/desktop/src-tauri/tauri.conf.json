{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fovea",
  "version": "0.1.0",
  "identifier": "com.utkarshrahim.fovea",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:43219",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Fovea",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#151515",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assignments/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.github.com/repos/UtkarshRahim/Fovea/releases/latest"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Photography",
    "shortDescription": "Present and review photographs",
    "longDescription": "Fovea opens camera RAW and JPEG files, shows their original camera data, lets you caption and present them fullscreen, and packages projects into portable .fovea files.",
    "copyright": "© 2026 Utkarsh Rahim. MIT License.",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/exiftool/": "exiftool/" },
    "fileAssociations": [
      {
        "ext": ["fovea"],
        "name": "Fovea project",
        "description": "Fovea project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-fovea"
      },
      {
        "ext": ["jpg", "jpeg", "jpe", "png", "gif", "webp", "avif", "bmp", "tif", "tiff", "heic", "heif"],
        "name": "Image",
        "description": "Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["nef", "nrw", "cr2", "cr3", "arw", "srf", "sr2", "dng", "raf", "orf", "rw2", "pef"],
        "name": "Camera RAW image",
        "description": "Camera RAW image",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
