{
  "$id": "https://framenote.app/schema/v1.json",
  "title": "Frame Note manifest v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "framenote"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "assignmentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "createdAt": {
      "type": "string"
    },
    "modifiedAt": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "const": "framenote"
        },
        "version": {
          "type": "string"
        },
        "platform": {
          "type": "string",
          "enum": [
            "web",
            "desktop"
          ]
        }
      },
      "required": [
        "app",
        "version",
        "platform"
      ]
    },
    "presentation": {
      "default": {},
      "type": "object",
      "properties": {
        "fitMode": {
          "default": "contain",
          "type": "string",
          "enum": [
            "contain",
            "cover"
          ]
        },
        "overlay": {
          "default": {},
          "type": "object",
          "properties": {
            "visible": {
              "default": true,
              "type": "boolean"
            },
            "placement": {
              "default": "bottom",
              "type": "string",
              "enum": [
                "top",
                "bottom"
              ]
            },
            "theme": {
              "default": "dark",
              "type": "string",
              "enum": [
                "dark",
                "light"
              ]
            },
            "fontSize": {
              "default": 16,
              "type": "number",
              "minimum": 8,
              "maximum": 64
            },
            "paddingX": {
              "default": 40,
              "type": "number",
              "minimum": 0,
              "maximum": 400
            },
            "paddingY": {
              "default": 22,
              "type": "number",
              "minimum": 0,
              "maximum": 400
            },
            "backgroundOpacity": {
              "default": 0.85,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fields": {
              "default": [
                "focalLength",
                "aperture",
                "shutterSpeed",
                "iso"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "focalLength",
                  "aperture",
                  "shutterSpeed",
                  "iso",
                  "camera",
                  "lens",
                  "exposureCompensation",
                  "capturedAt"
                ]
              }
            },
            "showCaption": {
              "default": true,
              "type": "boolean"
            },
            "showTitle": {
              "default": true,
              "type": "boolean"
            },
            "labelledGrid": {
              "default": true,
              "type": "boolean"
            },
            "direction": {
              "default": "horizontal",
              "type": "string",
              "enum": [
                "horizontal",
                "vertical"
              ]
            }
          }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "camera": {
            "type": "object",
            "properties": {
              "make": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            }
          },
          "lens": {
            "type": "object",
            "properties": {
              "make": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            }
          },
          "exposure": {
            "type": "object",
            "properties": {
              "aperture": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shutterSpeedSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "iso": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "focalLengthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "exposureCompensationEv": {
                "type": "number"
              }
            }
          },
          "capturedAt": {
            "type": "string"
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "orientation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "gps": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "latitude",
              "longitude"
            ]
          },
          "rawMetadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "type": {
            "type": "string",
            "const": "image"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "originalFilename": {
            "type": "string",
            "maxLength": 512
          },
          "asset": {
            "type": "string",
            "pattern": "^assets\\/[A-Za-z0-9._\\-/]+$"
          },
          "thumbnail": {
            "type": "string",
            "pattern": "^assets\\/[A-Za-z0-9._\\-/]+$"
          },
          "assetSource": {
            "type": "string",
            "enum": [
              "embedded-preview",
              "raw-decoded",
              "original-jpeg",
              "tiff-converted",
              "original-png"
            ]
          },
          "checksum": {
            "type": "object",
            "properties": {
              "algorithm": {
                "type": "string",
                "const": "sha256"
              },
              "asset": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "thumbnail": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "algorithm",
              "asset",
              "thumbnail"
            ]
          },
          "assetDimensions": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "user": {
            "default": {},
            "type": "object",
            "properties": {
              "caption": {
                "type": "string",
                "maxLength": 2000
              },
              "species": {
                "type": "string",
                "maxLength": 200
              },
              "location": {
                "type": "string",
                "maxLength": 200
              },
              "updatedAt": {
                "type": "string"
              }
            }
          },
          "comments": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "author": {
                  "type": "string",
                  "maxLength": 80
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text",
                "createdAt"
              ]
            }
          }
        },
        "required": [
          "id",
          "type",
          "order",
          "originalFilename",
          "asset",
          "thumbnail",
          "assetSource",
          "checksum"
        ]
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "assignmentId",
    "title",
    "createdAt",
    "modifiedAt",
    "generator",
    "images"
  ]
}
